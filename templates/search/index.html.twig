{% extends '_layouts/in_app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/inapp/search.css') }}">
{% endblock %}

{% block title %}Searching Toxicity{% endblock %}

{% block content %}
    <div class="search-grid-wrapper">

        {# --- CÔTÉ GAUCHE (5 BANDES) --- #}
        <aside class="vertical-separator side-left">
            <div class="v-ticker-wrap">
                {% for col in 1..5 %}
                    <div class="v-ticker-column">
                        {% for i in 1..3 %}
                            <span class="v-ticker-item">
                            {% set noise = "ABCDEF0123456789" %}
                                {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                            :: ERR_STRM_{{ random(100,999) }} ::
                            {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                        </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </aside>

        {# --- FLUX DE RÉSULTATS CENTRAL --- #}
        <main class="search-results-container">
            <div class="card-header">
                <span class="header-indicator"></span>
                <h2>SEARCH_RESULTS // QUERY_EXECUTED</h2>
            </div>

            {% if listTweets is empty %}
                <div class="terminal-alert">
                    <p>:: [WARNING] :: AUCUNE_OCCURRENCE_DETECTEE_DANS_LA_BASE</p>
                    <p>Vérifiez les paramètres de filtrage ou réessayez la requête.</p>
                </div>
            {% else %}
                <div class="tweets-feed">
                    {% for tweet in listTweets %}
                        <article class="tweet-card">
                            <div class="tweet-meta">
                                <a href="{{ path('user_show', {'username': tweet.authorName}) }}" class="author-tag">
                                    {{ tweet.authorName }}
                                </a>
                                <span class="timestamp">{{ tweet.createdDate | ago(locale='fr') }}</span>
                            </div>

                            <div class="tweet-content">
                                {{ tweet.message }}

                                {% if tweet.image %}
                                    <div class="tweet-image-wrapper">
                                        <img src="{{ asset('uploads/tweets/' ~ tweet.image) }}"
                                             alt="DATA_ATTACHMENT_{{ tweet.uid }}"
                                             class="tweet-content-image">
                                        <div class="image-overlay-scan"></div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="tweet-actions">
                                <div class="like-group">
                                    <a href="{{ path('likes_edit', {'tweet_uid': tweet.uid}) }}" class="like-btn {{ tweet.isLikedByMe ? 'is-liked' : '' }}">
                                        {{ tweet.isLikedByMe ? '♥' : '♡' }}
                                    </a>
                                    <span class="like-count">{{ tweet.totalLikes }}</span>
                                </div>

                                <a href="{{ path('tweets_show', {'uid': tweet.uid}) }}" class="detail-link">
                                    [ VIEW_DATA ]
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </main>

        {# --- CÔTÉ DROIT (5 BANDES) --- #}
        <aside class="vertical-separator side-right">
            <div class="v-ticker-wrap">
                {% for col in 1..5 %}
                    <div class="v-ticker-column">
                        {% for i in 1..3 %}
                            <span class="v-ticker-item">
                             :: LOG_VAL_{{ random(1000,9999) }} ::
                             {% set hex = "XYZ0123456789" %}
                                {% for j in 1..30 %}{{ hex|slice(random(12), 1) }}{% endfor %}
                             :: [REDACTED] ::
                        </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </aside>

    </div>
{% endblock %}
