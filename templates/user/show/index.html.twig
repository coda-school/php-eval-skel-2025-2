{% extends '_layouts/in_app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/inapp/profil.css') }}">
{% endblock %}

{% block title %}PROFIL: {{ informations.username }}{% endblock %}

{% block content %}
        <div class="profile-grid-wrapper">
            {# --- CÔTÉ GAUCHE (5 BANDES) --- #}
            <aside class="vertical-separator side-left">
                <div class="v-ticker-wrap">
                    {% for col in 1..5 %}
                        <div class="v-ticker-column">
                            {% for i in 1..3 %}
                                <span class="v-ticker-item">
                            {% set noise = "ABCDEF0123456789" %}
                                    {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                            :: ERR_STRM_{{ random(100,999) }} ::
                            {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                        </span>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </aside>

            <div class="profile-container">

                {# --- 1. CARTE INFORMATIONS --- #}
                <section class="user-profile-header">
                    <div class="terminal-card profile-card">
                        <div class="card-header">
                            <div class="header-main">
                                <span class="status-indicator active"></span>
                                <h1 class="terminal-title">>> USER_DATA: <span class="highlight">{{ informations.username }}</span></h1>
                            </div>
                            <div class="header-actions">
                                <button id="btn-copy-link" class="action-btn-mini">[ SHARE_LINK ]</button>
                                <span style="display: none" id="message-copy-link" class="status-tag">COPIED!</span>
                            </div>
                        </div>

                        <div class="profile-content">
                            <div class="profile-bio">
                                <span class="label">BIO:</span>
                                <p class="bio-text">{{ informations.bio ?: "Aucune information disponible dans la base." }}</p>
                            </div>

                            <div class="profile-footer-actions">
                                {% if app.user.username == informations.username %}
                                    <a href="{{ path('user_edit', {'username': app.user.username}) }}" class="deploy-btn">EDIT_PROFILE</a>
                                {% else %}
                                    <a href="{{ path('follows_edit', {'name': informations.username}) }}" class="deploy-btn">
                                        {{ is_followed ? "UNFOLLOW" : "FOLLOW_USER" }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>

                {# --- 2. CARROUSELS (FOLLOWED & FOLLOWERS) --- #}
                <section class="social-management">
                    <div class="carousel-section">
                        <h2 class="terminal-title">>> NETWORK: FOLLOWED ({{ nb_followed }})</h2>
                        <div class="horizontal-carousel">
                            {% for user in followed %}
                                <a href="{{ path('user_show', {'username': user.username}) }}" class="user-mini-card">
                                    <span class="user-prefix">@</span>{{ user.username }}
                                </a>
                            {% else %}
                                <p class="empty-msg">Aucun signal détecté.</p>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="carousel-section">
                        <h2 class="terminal-title">>> NETWORK: FOLLOWERS ({{ nb_followers }})</h2>
                        <div class="horizontal-carousel">
                            {% for user in followers %}
                                <a href="{{ path('user_show', {'username': user.username}) }}" class="user-mini-card">
                                    <span class="user-prefix">@</span>{{ user.username }}
                                </a>
                            {% else %}
                                <p class="empty-msg">Accès restreint ou aucun abonné.</p>
                            {% endfor %}
                        </div>
                    </div>
                </section>

                {# --- 3. LISTE DES TWEETS --- #}
                <section class="user-tweets">
                    <h2 class="terminal-title">>> DATA_LOGS: USER_MESSAGES</h2>
                    <div class="thread-container">
                        {% for tweet in tweets %}
                            <article class="tweet-card">
                                <div class="tweet-header">
                                    <div class="author-info">
                                        <span class="status-indicator"></span>
                                        <span class="author-name">{{ tweet.authorName }}</span>
                                    </div>
                                    <span class="tweet-date">{{ tweet.createdDate | ago(locale='fr') }}</span>
                                </div>

                                <div class="tweet-body">
                                    {{ tweet.message|nl2br }}
                                    {% if tweet.image %}
                                        <div class="tweet-image-wrapper">
                                            <img src="{{ asset('uploads/tweets/' ~ tweet.image) }}" class="tweet-content-image">
                                            <div class="image-overlay-scan"></div>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="tweet-footer">
                                    <div class="actions-left">
                                        <a href="{{ path('likes_edit', {'tweet_uid': tweet.uid}) }}" class="action-btn like-btn {{ tweet.isLikedByMe ? 'is-liked' : '' }}">
                                            <span class="icon">{{ tweet.isLikedByMe ? '♥' : '♡' }}</span>
                                            <span class="count">{{ tweet.totalLikes }}</span>
                                        </a>
                                    </div>
                                    <div class="actions-right">
                                        {% if tweet.updatedDate %}
                                            <span class="status-tag">MODIFIED</span>
                                        {% endif %}
                                        <a href="{{ path('tweets_show', {'uid': tweet.uid}) }}" class="detail-link">[ VIEW_DATA ]</a>
                                    </div>
                                </div>
                            </article>
                        {% else %}
                            <p class="empty-msg">Aucune archive disponible pour cet utilisateur.</p>
                        {% endfor %}
                        {#                <nav class="pagination-container">#}
                        {#                    {% for i in 1..maxPaginationPage %}#}
                        {#                        <a class="pagination-link {{ page == i ? 'active' : '' }}"#}
                        {#                           href="{{ path('user_show', {#}
                        {#                               'username': informations.username,#}
                        {#                               'page': i#}
                        {#                           }) }}">#}
                        {#                            {{ i|format('%02d') }}#}
                        {#                        </a>#}
                        {#                    {% endfor %}#}
                        {#                </nav>#}
                    </div>
                </section>
            </div>

            {# --- CÔTÉ DROIT (5 BANDES) --- #}
            <aside class="vertical-separator side-right">
                <div class="v-ticker-wrap">
                    {% for col in 1..5 %}
                        <div class="v-ticker-column">
                            {% for i in 1..3 %}
                                <span class="v-ticker-item">
                             :: LOG_VAL_{{ random(1000,9999) }} ::
                             {% set hex = "XYZ0123456789" %}
                                    {% for j in 1..30 %}{{ hex|slice(random(12), 1) }}{% endfor %}
                             :: [REDACTED] ::
                        </span>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </aside>
        </div>

{% endblock %}
