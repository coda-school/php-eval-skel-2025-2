{% extends '_layouts/in_app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/inapp/edit-tweet.css') }}">
{% endblock %}

{% block content %}
    <div class="edit-grid-wrapper">

        {# --- CÔTÉ GAUCHE (5 BANDES) --- #}
        <aside class="vertical-separator side-left">
            <div class="v-ticker-wrap">
                {% for col in 1..5 %}
                    <div class="v-ticker-column">
                        {% for i in 1..3 %}
                            <span class="v-ticker-item">
                            {% set noise = "ABCDEF0123456789" %}
                                {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                            :: ERR_STRM_{{ random(100,999) }} ::
                            {% for j in 1..20 %}{{ noise|slice(random(15), 1) }}{% endfor %}
                        </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </aside>

        {# --- FORMULAIRE CENTRAL --- #}
        <main class="edit-main-card">
            <div class="card-header">
                <span class="header-indicator"></span>
                <h2>MODIFICATION_CONTENU</h2>
            </div>

            {{ form_start(form, {'attr': {'class': 'terminal-form'}}) }}

            <div class="form-group">
                {{ form_label(form.message, "ÉDITER_MESSAGE_SOURCE") }}
                {{ form_widget(form.message, {'attr': {'class': 'terminal-input'}}) }}
                {{ form_errors(form.message) }}
            </div>

            {% if tweets.image %}
                <div class="current-image-preview">
                    <p class="label-small">VISUEL_ACTUEL :</p>
                    <div class="img-container">
                        <img src="{{ asset('uploads/tweets/' ~ tweets.image) }}" alt="Aperçu">
                    </div>
                    <div class="remove-toggle">
                        {{ form_widget(form.removeImage) }}
                        {{ form_label(form.removeImage, "SUPPRIMER_PIECE_JOINTE") }}
                    </div>
                </div>
            {% endif %}

            <div class="form-actions">
                {# --- BLOC GAUCHE (Upload) --- #}
                <div class="image-upload-zone">
                    <label for="{{ form.image.vars.id }}" class="deploy-btn">
                        MISE_A_JOUR_VISUEL
                    </label>
                    {{ form_widget(form.image, {'attr': {'class': 'input-file-hidden', 'onchange': 'updateFileName(this)'}}) }}

                    <div id="file-name-display">AUCUN_FICHIER_CHARGE</div>
                </div>

                {# --- BLOC DROITE (Boutons groupés) --- #}
                <div class="action-right-group">
                    <button type="submit" class="save-btn">APPLIQUER_MODIFS</button>
                    <a href="{{ path('tweets_show', {'uid': tweets.uid}) }}" class="cancel-btn">ANNULER_PROCÉDURE</a>
                </div>
            </div>
            <div id="file-chosen-error">{{ form_errors(form.image) }}</div>
{#            {{ form_end(form, {render_rest: false}) }}#}
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </main>

        {# --- CÔTÉ DROIT (5 BANDES) --- #}
        <aside class="vertical-separator side-right">
            <div class="v-ticker-wrap">
                {% for col in 1..5 %}
                    <div class="v-ticker-column">
                        {% for i in 1..3 %}
                            <span class="v-ticker-item">
                             :: LOG_VAL_{{ random(1000,9999) }} ::
                             {% set hex = "XYZ0123456789" %}
                                {% for j in 1..30 %}{{ hex|slice(random(12), 1) }}{% endfor %}
                             :: [REDACTED] ::
                        </span>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </aside>

    </div>
{% endblock %}
